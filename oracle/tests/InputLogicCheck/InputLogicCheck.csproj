<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline checks of the input path's pure logic (DelayLine, LatencyModel, HoldFilter); no game files needed:
       dotnet run -c Release -&#45;project oracle/tests/InputLogicCheck    (exit code 0 = all ok)
       The three sources are compiled in directly, so SsOracle itself is not built and nothing is deployed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- DelayLine.Item.HoldFrames / AckSeq are only read by ActionScheduler, which is not compiled here. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\Input\DelayLine.cs" Link="src\DelayLine.cs" />
    <Compile Include="..\..\src\Input\LatencyModel.cs" Link="src\LatencyModel.cs" />
    <Compile Include="..\..\src\Input\HoldFilter.cs" Link="src\HoldFilter.cs" />
  </ItemGroup>
</Project>
