<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check of the frame marker's code (MarkerCode.cs) against the vectors brain/tests/test_marker.py pins the
       Python decoder to; no game files needed:
       dotnet run -c Release -&#45;project oracle/tests/MarkerCheck    (exit code 0 = all ok)
       MarkerCode.cs is compiled in directly, so SsOracle itself is not built and nothing is deployed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\Export\MarkerCode.cs" Link="src\MarkerCode.cs" />
  </ItemGroup>
</Project>
