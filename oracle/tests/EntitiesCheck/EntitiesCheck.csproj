<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline checks of the Entities module's pure helpers (no Unity player needed):
       dotnet run -c Release -&#45;project oracle/tests/EntitiesCheck    (exit code 0 = all ok)
       Builds SsOracle with Deploy=false, so the training copy is never touched. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">C:\ssbot\game\train</GameDir>
    <Managed>$(GameDir)\Hollow Knight Silksong_Data\Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SsOracle.csproj" AdditionalProperties="Deploy=false" />
    <!-- Copied next to the exe: the checks load game types (enums, Matrix4x4) but never call into the engine. -->
    <Reference Include="0Harmony" HintPath="$(GameDir)\BepInEx\core\0Harmony.dll" />
    <Reference Include="BepInEx" HintPath="$(GameDir)\BepInEx\core\BepInEx.dll" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)\Assembly-CSharp.dll" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(Managed)\Assembly-CSharp-firstpass.dll" />
    <Reference Include="PlayMaker" HintPath="$(Managed)\PlayMaker.dll" />
    <Reference Include="TeamCherry.TK2D" HintPath="$(Managed)\TeamCherry.TK2D.dll" />
    <Reference Include="TeamCherry.SharedUtils" HintPath="$(Managed)\TeamCherry.SharedUtils.dll" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.Physics2DModule" HintPath="$(Managed)\UnityEngine.Physics2DModule.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(Managed)\UnityEngine.UI.dll" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(Managed)\UnityEngine.UIModule.dll" />
    <Reference Include="netstandard" HintPath="$(Managed)\netstandard.dll" />
  </ItemGroup>
</Project>
